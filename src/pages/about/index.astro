---
import Base from '../../layouts/Base.astro';
---
<Base title="About — Video Game Palooza Foundation (d/b/a Hope Training Academy)"
      description="Video Game Palooza, Inc. is a 501(c)(3) public charity (EIN 46-4169197) in Indianapolis — a community workforce-development organization opening doors to living-wage digital-economy careers. Volunteer-led. 2,000+ served.">
  <section class="section" style="background:linear-gradient(180deg,#0f1d3d,#0a1226);text-align:center">
    <div class="wrap" style="max-width:820px">
      <span class="eyebrow">Our Mission</span>
      <h2>To end the cycle of poverty through the digital economy</h2>
      <p style="color:#dce6fb;font-size:1.18rem;line-height:1.8;margin-top:14px">
        “To end the cycle of poverty for underserved and low-income people by opening doors to living-wage
        careers in the digital economy — through free training, recognized credentials, apprenticeship
        pathways, and real employment building the tools of digital trust.”
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="max-width:820px">
      <span class="eyebrow">Who We Are</span>
      <h2>A community charity with a modern digital mission</h2>
      <p style="color:var(--mut);font-size:1.1rem;line-height:1.8">
        <strong>Video Game Palooza, Inc.</strong> is a 501(c)(3) public charity based in Carmel /
        Indianapolis, Indiana, doing business as <strong>Hope Training Academy</strong>. We are a community
        workforce-development organization — not a school (IRS classification 170(b)(1)(A)(vi)) — with a
        charitable purpose of relieving poverty, advancing social welfare, and advancing education.
      </p>
      <p style="color:var(--mut);font-size:1.1rem;line-height:1.8">
        Founded in 2013 to use video games to educate, inspire, and give back, we've grown into hands-on
        tech workforce development and are now expanding into digital content authenticity and creative-tech
        operations. Our leadership is volunteer and uncompensated — <strong>Rick Barretto, President</strong>.
      </p>

      <div class="creds" style="border-radius:14px;margin:26px 0">
        <div class="wrap">
          <div><div class="n">501(c)(3)</div><div class="l">EIN 46-4169197</div></div>
          <div><div class="n">Est. 2013</div><div class="l">Serving since 2018</div></div>
          <div><div class="n">2,000+</div><div class="l">People served</div></div>
          <div><div class="n">DOL</div><div class="l">Registered Apprenticeship</div></div>
        </div>
      </div>

      <h3 style="margin-top:8px">Our charitable purpose</h3>
      <ul style="color:var(--mut);font-size:1.08rem;line-height:1.9">
        <li><strong>Relief of poverty</strong> — free training and real employment for those who need it most.</li>
        <li><strong>Social welfare</strong> — building an inclusive, next-generation digital workforce.</li>
        <li><strong>Advancing education</strong> — recognized credentials and apprenticeship, not debt.</li>
      </ul>

      <h3 style="margin-top:26px">Our programs</h3>
      <p style="color:var(--mut);font-size:1.08rem;line-height:1.8">We carry out our mission through
        <a href="https://hopetrainingacademy.org/" target="_blank" rel="noopener">Hope Training Academy</a>
        (training &amp; apprenticeship), <a href="https://eververify.org/" target="_blank" rel="noopener">EverVerify</a>
        (our flagship digital-trust registry), our 10-year <a href="/retro-charity-arcade/">Retro Charity Arcade</a>,
        and our <a href="/programs/">STEM &amp; youth programs</a>.</p>

      <p style="margin-top:26px"><a class="btn hope" href="/get-involved/#donate">Support Our Mission</a>
        &nbsp;<a class="btn ghost" href="/contact/">Contact Us</a></p>
      <p style="color:var(--mut);font-size:.9rem;margin-top:18px"><em>The refreshed mission statement reflects
        our board-approved direction; formal exempt-purpose language is finalized by the board.</em></p>
    </div>
  </section>
</Base>
