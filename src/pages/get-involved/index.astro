---
import Base from '../../layouts/Base.astro';
---
<Base title="Get Involved — Donate, Volunteer, Partner | Video Game Palooza, Inc."
      description="Support a 501(c)(3) that turns donations into training, credentials, and living-wage jobs. Donate, volunteer, or partner with Video Game Palooza (d/b/a Hope Training Academy) in Indianapolis.">
  <section class="section" style="background:linear-gradient(180deg,#0f1d3d,#0a1226);text-align:center">
    <div class="wrap" style="max-width:820px">
      <span class="eyebrow">Get Involved</span>
      <h2>Fund training. Fund a job. Change a life.</h2>
      <p style="color:var(--mut);font-size:1.12rem;margin-top:12px">We're a 501(c)(3) public charity —
        donations are tax-deductible to the extent allowed by law, and every dollar puts a Hoosier to work.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="give">
        <div class="givecard donate" id="donate">
          <h3>💚 Donate</h3>
          <p style="color:var(--mut)">Your gift funds free training <em>and</em> the living-wage jobs our
            graduates step into. The public EverVerify registry stays free for everyone.</p>
          <p style="margin-top:14px"><a class="btn hope" href="#give-form">Make a Gift</a></p>
        </div>
        <div class="givecard donate" id="sponsor">
          <h3>🎓 Sponsor a Learner</h3>
          <p style="color:var(--mut)">Underwrite one person's journey from hardship to a living-wage tech
            career — training, credential, and the job on the other side. The most direct way to change a life.</p>
          <p style="margin-top:14px"><a class="btn hope" href="#give-form">Sponsor a Learner</a></p>
        </div>
        <div class="givecard" id="volunteer">
          <h3>🙌 Volunteer</h3>
          <p style="color:var(--mut)">Mentor a learner, help at a Retro Charity Arcade event, or lend your
            tech expertise. Our leadership is volunteer-led — join us.</p>
          <p style="margin-top:14px"><a class="btn" href="#give-form">Volunteer</a></p>
        </div>
        <div class="givecard" id="partner">
          <h3>🤝 Partner With Us</h3>
          <p style="color:var(--mut)">Employers, workforce boards, and community organizations: help us turn
            training into hiring, or bring the arcade to your event.</p>
          <p style="margin-top:14px"><a class="btn" href="#give-form">Partner</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background:linear-gradient(180deg,#0b1631,#0a1226)">
    <div class="wrap" style="max-width:680px" id="give-form">
      <h2 style="text-align:center">Start here</h2>
      <p style="text-align:center;color:var(--mut);margin-bottom:22px">Tell us how you'd like to help and we'll
        be in touch right away.</p>
      <form id="vform" class="tlnform">
        <input type="text" name="company" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
        <label>Name*<input name="name" required /></label>
        <label>Email*<input name="email" type="email" required /></label>
        <label>Phone<input name="phone" /></label>
        <label>Organization<input name="org" /></label>
        <label>I'd like to
          <select name="interest">
            <option>Donate</option>
            <option>Sponsor a Learner</option>
            <option>Volunteer</option>
            <option>Partner With Us</option>
            <option>Bring the Retro Charity Arcade to an event</option>
            <option>Join a training program</option>
            <option>Something else</option>
          </select>
        </label>
        <label>Message*<textarea name="message" rows="5" required></textarea></label>
        <button type="submit" class="btn hope">Send →</button>
        <p id="vmsg" class="formmsg" role="status"></p>
      </form>
    </div>
  </section>

  <script is:inline>
    const f = document.getElementById('vform');
    const m = document.getElementById('vmsg');
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      m.textContent = 'Sending…';
      const data = Object.fromEntries(new FormData(f).entries());
      try {
        const r = await fetch('/api/contact', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) });
        const j = await r.json();
        if (j.ok) { f.reset(); m.textContent = 'Thank you — we received your message and will be in touch soon.'; m.className = 'formmsg ok'; }
        else { m.textContent = j.error || 'Something went wrong. Please email foundation@videogamepalooza.org.'; m.className = 'formmsg err'; }
      } catch { m.textContent = 'Network error. Please try again or email us directly.'; m.className = 'formmsg err'; }
    });
  </script>
</Base>
