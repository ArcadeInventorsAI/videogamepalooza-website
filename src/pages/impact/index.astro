---
import Base from '../../layouts/Base.astro';
---
<Base title="Our Impact — Video Game Palooza Foundation"
      description="2,000+ people served since 2018, a U.S. Department of Labor Registered Apprenticeship, and a decade of the Retro Charity Arcade. See how Video Game Palooza turns donations into training, credentials, and living-wage jobs.">
  <section class="section" style="background:linear-gradient(180deg,#0f1d3d,#0a1226);text-align:center">
    <div class="wrap" style="max-width:820px">
      <span class="eyebrow">Our Impact</span>
      <h2>Every dollar puts a Hoosier to work</h2>
      <p style="color:var(--mut);font-size:1.12rem;margin-top:12px">We measure success one way: people moved
        from hardship into stable, living-wage careers in the digital economy.</p>
    </div>
  </section>

  <section class="creds">
    <div class="wrap">
      <div><div class="n">2,000+</div><div class="l">People served since 2018</div></div>
      <div><div class="n">DOL</div><div class="l">Registered Apprenticeship sponsor</div></div>
      <div><div class="n">10 yrs</div><div class="l">Retro Charity Arcade</div></div>
      <div><div class="n">100%</div><div class="l">Volunteer-led leadership</div></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="max-width:820px">
      <h2>How your support creates opportunity</h2>
      <p style="color:var(--mut);font-size:1.1rem;line-height:1.8">Our model is different: we don't just
        train people for jobs that exist — we <strong>create the jobs</strong> by operating real
        digital-trust infrastructure and staffing it with the people we serve. Donations fund the training
        <em>and</em> the employment; the public registry stays free for everyone.</p>

      <div class="give" style="margin-top:24px">
        <div class="givecard donate"><h3>Free training</h3><p style="color:var(--mut)">Recognized credentials
          in IT, cybersecurity, AI, and digital-content authenticity — at no cost to the learner.</p></div>
        <div class="givecard"><h3>Registered apprenticeship</h3><p style="color:var(--mut)">A real,
          DOL-registered path from beginner to hired, backed by workforce and community partners.</p></div>
        <div class="givecard"><h3>Real employment</h3><p style="color:var(--mut)">Graduates operate
          <a href="https://eververify.org/" target="_blank" rel="noopener" style="color:var(--cyan)">EverVerify</a>
          — living-wage, credentialed digital-trust jobs we created.</p></div>
      </div>

      <h3 style="margin-top:30px">Built with Indiana's best</h3>
      <p style="color:var(--mut);font-size:1.08rem;line-height:1.8">We partner with employers, workforce
        boards, and community organizations across Indianapolis to make sure training leads to real hiring.
        Interested in partnering or hiring our graduates? <a href="/get-involved/#partner">Let's talk.</a></p>

      <p style="margin-top:26px"><a class="btn hope" href="/get-involved/#donate">Fund a Career</a>
        &nbsp;<a class="btn ghost" href="/impact/">Share a Story</a></p>
    </div>
  </section>
</Base>
