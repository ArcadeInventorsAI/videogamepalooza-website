---
import Base from '../layouts/Base.astro';
---
<Base>
  <section class="mhero">
    <div class="wrap">
      <span class="kicker">Video Game Palooza Foundation · Since 2013</span>
      <h1>Careers in the digital economy — for the people left out of it.</h1>
      <p class="lede">We're a 501(c)(3) charity in Indianapolis that lifts underserved people out of poverty
        by training them for living-wage digital careers — and putting them to work building the tools of
        digital trust. We don't just train for jobs. We build them.</p>
      <div class="cta-row">
        <a class="btn hope" href="/get-involved/#donate">Donate</a>
        <a class="btn" href="/programs/">Explore Our Programs</a>
        <a class="btn ghost" href="/retro-charity-arcade/">The Retro Charity Arcade</a>
      </div>
    </div>
  </section>

  <section class="creds">
    <div class="wrap">
      <div><div class="n">501(c)(3)</div><div class="l">Public charity · EIN 46-4169197</div></div>
      <div><div class="n">2,000+</div><div class="l">People served since 2018</div></div>
      <div><div class="n">DOL</div><div class="l">Registered Apprenticeship sponsor</div></div>
      <div><div class="n">Indianapolis</div><div class="l">Carmel / Indianapolis, IN</div></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="max-width:860px;text-align:center">
      <span class="eyebrow">Our Evolution</span>
      <h2>From video games for good to building the tools of digital trust</h2>
      <p style="color:var(--mut);font-size:1.12rem;line-height:1.8;margin-top:14px">
        We began by using video games to educate, inspire, and give back. That grew into hands-on tech
        workforce development — cybersecurity, IT support, AI, and digital literacy. Now we're expanding
        into the fastest-growing frontier of the digital economy: <strong>digital content authenticity and
        creative-tech operations</strong> — the work of proving what's real in an AI-saturated world.
        Our model is what makes us different: we don't only train people for jobs that exist —
        <strong> we create the jobs</strong>, by operating real digital-trust infrastructure and staffing
        it with the people we serve.
      </p>
    </div>
  </section>

  <section class="section" style="background:linear-gradient(180deg,#0b1631,#0a1226)">
    <div class="wrap">
      <div style="text-align:center;max-width:760px;margin:0 auto 34px">
        <span class="eyebrow">What We Do</span>
        <h2>One charity, three ways we change lives</h2>
      </div>
      <div class="brands">
        <a class="brandcard" href="https://hopetrainingacademy.org/" target="_blank" rel="noopener">
          <div class="top"><span class="tag">Training &amp; Apprenticeship</span>
            <h3>Hope Training Academy</h3></div>
          <p>Free, hands-on training in IT, cybersecurity, AI, and digital literacy — with a real
            DOL-registered apprenticeship path from beginner to hired. Every program leads to a credential
            and a job, not a degree.</p>
          <span class="go">Visit hopetrainingacademy.org ↗</span>
        </a>
        <a class="brandcard" href="https://eververify.org/" target="_blank" rel="noopener">
          <div class="top"><span class="tag">Flagship · Launching</span>
            <h3>EverVerify</h3></div>
          <p>A free public-benefit registry where creators prove their images and videos are real and
            theirs. Operating it — verification, content review, registry work — becomes credentialed,
            living-wage employment for the people we train.</p>
          <span class="go">Visit eververify.org ↗</span>
        </a>
        <a class="brandcard" href="/retro-charity-arcade/">
          <div class="top"><span class="tag">10 Years · Community</span>
            <h3>Retro Charity Arcade</h3></div>
          <p>For a decade, our traveling retro arcade has brought free classic gaming to hospitals,
            museums, and community events across Indiana — raising funds and spreading joy where it's
            needed most.</p>
          <span class="go">See the Arcade →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="arcadefeat">
        <div>
          <span class="badge">★ 10 Years of the Retro Charity Arcade ★</span>
          <h2>Insert coin. Change a life.</h2>
          <p>Our Retro Charity Arcade has been a labor of love for ten years — a cabinet full of the
            greatest classic games, wheeled into children's hospitals, the Indiana State Museum, and
            community fundraisers. It's free to play, it puts smiles on faces during hard days, and every
            event advances our mission. It's where Video Game Palooza started — and it's still going strong.</p>
          <p style="margin-top:18px">
            <a class="btn" href="/retro-charity-arcade/">Explore the Arcade</a>
            &nbsp;<a class="btn hope" href="/get-involved/#donate">Sponsor an Event</a>
          </p>
        </div>
        <div class="retro">
          <img src="/img/vgp/insert-credits.png" alt="Insert Credits" loading="lazy" />
          <img src="/img/vgp/game-on.png" alt="Game On" loading="lazy" />
          <img src="/img/vgp/select-level.png" alt="Select Level" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background:linear-gradient(180deg,#0b1631,#0a1226)">
    <div class="wrap">
      <div style="text-align:center;max-width:760px;margin:0 auto 30px">
        <span class="eyebrow">Who We Serve</span>
        <h2>The people traditional pathways left behind</h2>
        <p style="color:var(--mut);font-size:1.1rem;margin-top:12px">Low-income and underemployed adults,
          opportunity youth, and residents of underserved Indianapolis neighborhoods — for whom technology
          careers have felt out of reach. The AI-authenticity wave is creating a surge of future-proof
          digital-trust jobs. We train people directly into it.</p>
        <p style="margin-top:22px"><a class="btn" href="/impact/">See Our Impact</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="text-align:center;max-width:820px">
      <span class="eyebrow">Get Involved</span>
      <h2>Fund training. Fund a job. Change a life.</h2>
      <p style="color:var(--mut);font-size:1.1rem;margin-top:12px">Donations fund the training <em>and</em> the
        jobs — the registry itself stays free to the public. Every dollar puts a Hoosier to work.</p>
      <div class="cta-row" style="margin-top:24px">
        <a class="btn hope" href="/get-involved/#donate">Donate</a>
        <a class="btn" href="/get-involved/#volunteer">Volunteer</a>
        <a class="btn ghost" href="/get-involved/#partner">Partner With Us</a>
      </div>
    </div>
  </section>
</Base>
