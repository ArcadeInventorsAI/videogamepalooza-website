---
import Base from '../../layouts/Base.astro';
---
<Base title="Our Programs — Video Game Palooza, Inc."
      description="Free training pathways in IT, cybersecurity, AI, digital literacy, and the new digital content authenticity & creative-tech track — plus STEM & youth programs and the Retro Charity Arcade. Every program leads to a credential and a job.">
  <section class="section" style="background:linear-gradient(180deg,#0f1d3d,#0a1226);text-align:center">
    <div class="wrap" style="max-width:820px">
      <span class="eyebrow">What We Do</span>
      <h2>Every program leads to a credential and a job — not a degree</h2>
      <p style="color:var(--mut);font-size:1.12rem;margin-top:12px">Free, hands-on pathways that move people
        from beginner to hired, plus community programs that give back.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 style="text-align:center;margin-bottom:8px">Training &amp; apprenticeship pathways</h2>
      <p style="text-align:center;color:var(--mut);max-width:720px;margin:0 auto 30px">Delivered through our
        d/b/a <a href="https://hopetrainingacademy.org/" target="_blank" rel="noopener">Hope Training Academy</a> —
        in person in Indianapolis or online.</p>
      <div class="progs">
        <div class="progcard"><img src="/img/vgp/coding-stem.jpg" alt="Cybersecurity training" /><div class="b"><h3>Cybersecurity</h3><p>Hands-on defensive security skills for one of the highest-demand fields in tech.</p></div></div>
        <div class="progcard"><img src="/img/vgp/stem-diversity.jpg" alt="IT support training" /><div class="b"><h3>IT &amp; Desktop Support</h3><p>The proven on-ramp to a tech career — help-desk to systems support.</p></div></div>
        <div class="progcard"><img src="/img/vgp/diversity.jpg" alt="AI training" /><div class="b"><h3>Artificial Intelligence</h3><p>Practical AI skills and tooling for the modern digital workplace.</p></div></div>
        <div class="progcard"><img src="/img/vgp/kids-gaming.jpg" alt="Digital literacy" /><div class="b"><h3>Digital Literacy &amp; Entrepreneurship</h3><p>Foundational skills and the confidence to build a livelihood online.</p></div></div>
      </div>
      <div class="arcadefeat" style="margin-top:30px;background:linear-gradient(135deg,#0c231a,#0a1226 60%);border-color:var(--hope-deep)">
        <div>
          <span class="badge" style="background:#0c2a1e;color:#7ff0c0;border-color:var(--hope-deep)">New · Launching</span>
          <h2>Digital Content Authenticity &amp; Creative-Tech Ops</h2>
          <p>Our newest pathway trains people to prove what's real in an AI-saturated world — verification
            operations, content review, and registry/data work — then employs them running
            <a href="https://eververify.org/" target="_blank" rel="noopener" style="color:var(--cyan)">EverVerify</a>,
            our public digital-trust registry. New laws (the EU AI Act in Aug 2026 and U.S. equivalents) are
            creating a surge of these future-proof jobs. We train underserved people directly into that wave.</p>
          <p style="margin-top:16px"><a class="btn" href="https://hopetrainingacademy.org/" target="_blank" rel="noopener">Join a program at Hope Training Academy ↗</a></p>
        </div>
        <div class="retro"><img src="/img/vgp/select-level.png" alt="Select Level" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <section class="section" style="background:linear-gradient(180deg,#0b1631,#0a1226)">
    <div class="wrap">
      <h2 style="text-align:center;margin-bottom:8px">STEM, youth &amp; community programs</h2>
      <p style="text-align:center;color:var(--mut);max-width:720px;margin:0 auto 30px">The roots of Video Game
        Palooza — using young people's passion for playing and making games to build real skills.</p>
      <div class="progs">
        <div class="progcard"><img src="/img/vgp/stem-diversity.jpg" alt="STEM game challenge" /><div class="b"><h3>STEM Game Challenge</h3><p>Game-based STEM learning that connects classwork to real-world engineering, science, and math.</p></div></div>
        <div class="progcard"><img src="/img/vgp/diversity.jpg" alt="Diversity in gaming" /><div class="b"><h3>Diversity in Gaming</h3><p>Growing the number of women and underrepresented people in the game and tech industries.</p></div></div>
        <div class="progcard"><img src="/img/vgp/kids-gaming.jpg" alt="Camps and after-school" /><div class="b"><h3>Camps &amp; After-School</h3><p>Game design, coding, graphics, and mobile game creation for grades K-12.</p></div></div>
        <div class="progcard"><img src="/img/vgp/coding-stem.jpg" alt="Esports and exergaming" /><div class="b"><h3>Esports &amp; Exergaming</h3><p>Team esports and active "exergaming" that build teamwork, focus, and healthy habits.</p></div></div>
      </div>
      <p style="text-align:center;margin-top:30px"><a class="btn" href="/retro-charity-arcade/">And our 10-year Retro Charity Arcade →</a></p>
    </div>
  </section>
</Base>
