---
import Base from '../../layouts/Base.astro';
---
<Base title="The Retro Charity Arcade — 10 Years of Gaming for Good | Video Game Palooza"
      description="For 10 years, Video Game Palooza's Retro Charity Arcade has brought free classic arcade gaming to children's hospitals, the Indiana State Museum, and community fundraisers across Indiana — raising funds and spreading joy for our mission.">
  <section class="section" style="background:linear-gradient(135deg,#160b2e,#0a1226 60%);text-align:center">
    <div class="wrap" style="max-width:880px">
      <span class="badge" style="display:inline-block;background:#2a1650;color:#e9b3ff;border:1px solid #6c3bb0;border-radius:999px;padding:6px 16px;font-size:.74rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em">★ Celebrating 10 Years ★</span>
      <h1 style="font-family:'Press Start 2P',monospace;font-size:clamp(1.2rem,3.4vw,2rem);line-height:1.5;margin:.6em 0">The Retro Charity Arcade</h1>
      <p style="color:#dce6fb;font-size:1.2rem;line-height:1.7">Free-to-play classic gaming, wheeled straight
        to the people who need a smile most. It's where Video Game Palooza began — and a decade later, it's
        still bringing joy and raising funds for our mission.</p>
      <div class="retro" style="display:flex;gap:14px;justify-content:center;align-items:end;margin-top:26px">
        <img src="/img/vgp/insert-credits.png" alt="Insert Credits" style="height:150px" loading="eager" />
        <img src="/img/vgp/game-on.png" alt="Game On" style="height:180px" loading="eager" />
        <img src="/img/vgp/select-level.png" alt="Select Level" style="height:150px" loading="eager" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="max-width:820px">
      <span class="eyebrow">A Decade of Giving Back</span>
      <h2>Ten years, hundreds of smiles</h2>
      <p style="color:var(--mut);font-size:1.12rem;line-height:1.8">Our Retro Charity Arcade is a hand-built
        cabinet loaded with the greatest classic games ever made — and for ten years it's traveled Indiana
        doing good. Free to play, always. Every appearance raises awareness and funds for our charitable
        programs, and every game brings a moment of pure fun to someone who needs it.</p>

      <div class="give" style="margin-top:26px">
        <div class="givecard"><h3>🏥 Children's Hospitals</h3><p style="color:var(--mut)">We bring the arcade
          to kids during long hospital stays — a welcome escape and a reason to smile on a hard day.</p></div>
        <div class="givecard"><h3>🏛️ Indiana State Museum</h3><p style="color:var(--mut)">A featured charity
          arcade experience connecting the community with the history and joy of classic gaming.</p></div>
        <div class="givecard"><h3>🎗️ Community Fundraisers</h3><p style="color:var(--mut)">From local events to
          corporate giving, the arcade turns play into support for our mission.</p></div>
      </div>
    </div>
  </section>

  <section class="section" style="background:linear-gradient(180deg,#0b1631,#0a1226);text-align:center">
    <div class="wrap" style="max-width:760px">
      <h2>Bring the arcade to your event — or help keep it rolling</h2>
      <p style="color:var(--mut);font-size:1.1rem;margin-top:12px">Sponsor an appearance, invite the arcade to
        your hospital or community event, or donate to keep this 10-year tradition alive.</p>
      <div class="cta-row" style="margin-top:24px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
        <a class="btn hope" href="/get-involved/#donate">Donate</a>
        <a class="btn" href="/contact/">Request the Arcade</a>
      </div>
    </div>
  </section>
</Base>
